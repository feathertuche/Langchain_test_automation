import os
from pinecone import Pinecone
from sentence_transformers import SentenceTransformer
from dotenv import load_dotenv

# Load environment variables from .env file
load_dotenv()

class PineconeConn:
    def __init__(self, pine_index_name: str, pine_embedding_model: str):
        self.pine_index_name = pine_index_name
        self.pine_embedding_model = pine_embedding_model
        self.index = None
        self.embedder = None

    @classmethod
    def get_pinecone_connection(cls, pine_index_name: str, pine_embedding_model: str):
        print("This is Pinecone connection block")
        # Initialize Pinecone connection
        pine = Pinecone(api_key=os.getenv("PINECONE_API_KEY"))
        print("Pinecone connection initiated")

        # Pinecone connection builder
        conn = cls(pine_index_name, pine_embedding_model)
        conn.index = pine.Index(host=os.getenv("PINECONE_HOST"))
        try:
            conn.embedder = SentenceTransformer(pine_embedding_model)
        except Exception as e:
            print(f"Failed to load embedding model: {pine_embedding_model}")
            raise e
        return conn


def main():
	# Define config values
	index_name = "llm-index"
	embedding_model = os.getenv('EMBED_MODEL')

	# Create connection
	conn = PineconeConn.get_pinecone_connection(index_name, embedding_model)

	# Now you can use:
	query_vector = conn.embedder.encode("What is LangGraph?")
	results = conn.index.query(vector=query_vector.tolist(), top_k=5, include_metadata=True)

	print(results)
	
if __name__ == '__main__':
	main()

